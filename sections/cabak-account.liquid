{{ 'cabak-account.css' | asset_url | stylesheet_tag }}

<section class="cabak-account" aria-labelledby="cabak-account-title">
  <div class="cabak-account__intro">
    <img
      class="cabak-account__symbol"
      src="{{ 'cabak-symbol-transparent.png' | asset_url }}"
      width="1254"
      height="1254"
      alt="CABAK Activewear"
    >
    <p class="cabak-account__eyebrow">FUERZA · CONFIANZA · BIENESTAR</p>
    <p class="cabak-account__statement">Tu movimiento.<br>Tu espacio.</p>
    <p class="cabak-account__intro-copy">Todo lo que te acompaña, en un solo lugar.</p>
    <a class="cabak-account__back" href="{{ routes.all_products_collection_url }}">Explorar la colección <span aria-hidden="true">↗</span></a>
  </div>

  <div class="cabak-account__panel">
    <p class="cabak-account__eyebrow">MI CUENTA CABAK</p>
    {% if customer %}
      <h1 id="cabak-account-title">Qué bueno verte{% if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif %}.</h1>
      <p class="cabak-account__description">Consulta tus pedidos y administra tus datos desde tu cuenta.</p>
      <a class="cabak-account__primary" href="{{ routes.account_url }}">Ir a mi cuenta <span aria-hidden="true">→</span></a>
    {% elsif shop.customer_accounts_enabled %}
      <h1 id="cabak-account-title">Bienvenida<br>a tu espacio.</h1>
      <p class="cabak-account__description">Inicia sesión o crea tu cuenta con tu correo electrónico.</p>

      <div class="cabak-account__access">
        <shopify-account class="cabak-account__native" menu="customer-account-main-menu">
          <span slot="signed-out-avatar" class="cabak-account__cta-label">
            Continuar con mi correo <span aria-hidden="true">→</span>
          </span>
        </shopify-account>
        <a class="cabak-account__primary cabak-account__fallback" href="{{ routes.account_login_url }}">Continuar con mi correo <span aria-hidden="true">→</span></a>
      </div>

      <p class="cabak-account__help">Te enviaremos un código de verificación.<br>Sin contraseñas que recordar.</p>

      <div class="cabak-account__registration">
        <h2>¿Es tu primera vez en CABAK?</h2>
        <p>Usa el mismo botón. Al verificar tu correo, se creará tu cuenta.</p>
      </div>
    {% else %}
      <h1 id="cabak-account-title">Tu espacio CABAK.</h1>
      <p class="cabak-account__description">El acceso a cuentas no está disponible en este momento. Puedes seguir explorando la tienda.</p>
      <a class="cabak-account__primary" href="{{ routes.all_products_collection_url }}">Ver la colección <span aria-hidden="true">→</span></a>
    {% endif %}

    <div class="cabak-account__details">
      <span>Tus pedidos, a mano</span>
      <span>Tus datos, en un solo lugar</span>
    </div>
    {% if shop.privacy_policy != blank %}
      <a class="cabak-account__privacy" href="{{ shop.privacy_policy.url }}">Política de privacidad</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CABAK · Mi cuenta",
  "enabled_on": { "templates": ["page"] },
  "settings": [],
  "presets": [{ "name": "CABAK · Mi cuenta" }]
}
{% endschema %}
